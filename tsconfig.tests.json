{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".test-build",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/config/gameBalance.ts",
    "src/lib/economics/**/*.ts",
    "src/lib/leafletLayerLifecycle.ts",
    "src/lib/leafletTileReadiness.ts",
    "tests/gameSaveStorage.test.ts",
    "tests/leafletLayerLifecycle.test.ts",
    "tests/leafletTileReadiness.test.ts",
    "tests/mapLibreErrorPolicy.test.ts",
    "tests/routeEconomics.test.ts",
    "tests/saveCompatibility.test.ts"
  ]
}
